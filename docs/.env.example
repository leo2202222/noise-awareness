THINGSBOARD_URL=https://thingsboard.cloud
THINGSBOARD_DEVICE_ID=26330d60-e196-11f1-ba8b-c1a2c9300913
THINGSBOARD_API_KEY=
PORT=3000
# When hosting over HTTPS, set COOKIE_SECURE=true.
COOKIE_SECURE=false
# Use your public HTTPS site URL or mailto contact when deploying publicly.
VAPID_SUBJECT=https://localhost:3000

# Authentication provider (local is retained only for rollback).
AUTH_PROVIDER=thingsboard
# Expected tenant and pre-existing NAS customer (IDs are not secrets).
THINGSBOARD_TENANT_ID=
THINGSBOARD_REGISTRATION_CUSTOMER_ID=
THINGSBOARD_REGISTRATION_ENABLED=true
# Cloud/PE entity group sharing; verified on ThingsBoard Cloud 4.4.1PAAS.
THINGSBOARD_GROUP_SHARING=true
# Optional dedicated backend-only provisioning key; existing THINGSBOARD_API_KEY is fallback.
THINGSBOARD_ADMIN_API_KEY=
# Optional: 32 random bytes as base64. Otherwise data/tb-session.key is generated privately.
SESSION_ENCRYPTION_KEY=
# Set these only behind your trusted HTTPS reverse proxy in production.
TRUST_PROXY=false
NODE_ENV=development
